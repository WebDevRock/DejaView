# SQLite file path. Relative paths resolve from the project root.
DATABASE_URL=./data/dejaview.sqlite

# Optional Jira Cloud provider. Values are read on the server only.
# Use the tenant origin only; HTTPS *.atlassian.net hosts are accepted.
# JIRA_BASE_URL=https://your-tenant.atlassian.net
# JIRA_EMAIL=support-account@example.com
# JIRA_API_TOKEN=store-the-token-in-your-secret-manager
# JIRA_PROJECT_KEYS=SUP,OPS
# JIRA_SOURCE_LABEL=Support Jira
# JIRA_TIMEOUT_MS=5000
