# SQLite file path. Relative paths resolve from the project root.
DATABASE_URL=./data/dejaview.sqlite

# Local seeded editor. Set to true only in .env.local for development.
# This setting is ignored when NODE_ENV=production.
DEJAVIEW_LOCAL_AUTH=false

# Required in production to sign search cursors. Supply a long random value
# through the deployment secret manager; never deploy this placeholder.
# DEJAVIEW_CURSOR_SECRET=replace-with-a-long-random-secret

# Optional Jira Cloud provider. Uncomment the complete block in .env.local or
# provide equivalent server-side environment values. Never commit real details.
# JIRA_BASE_URL=https://your-tenant.atlassian.net
# JIRA_EMAIL=service-account@example.invalid
# JIRA_API_TOKEN=replace-with-a-secret-manager-value
# JIRA_PROJECT_KEYS=SUP,OPS
# JIRA_SOURCE_LABEL=Jira
# JIRA_TIMEOUT_MS=5000
